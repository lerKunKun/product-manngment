# 节点 A backend + frontend 环境变量模板
# 复制：sudo install -m 600 -o app -g app /dev/null /opt/shopifyhub/.env
#       然后参考本文件填实际值
# 永远不要 commit 真值！

# ============ 数据库 ============
APP_ENV=prod
APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_PLATFORM_DB=shopifyhub
MYSQL_USER=shopifyhub
MYSQL_PASSWORD=__FILL_STRONG_PWD__
MYSQL_TLS_REQUIRED=false

# ============ Redis ============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=__FILL_REDIS_PWD__

# ============ RabbitMQ ============
MQ_HOST=127.0.0.1
MQ_PORT=5672
MQ_USER=shopifyhub
MQ_PASS=__FILL_RMQ_PWD__

# ============ Asset Worker（节点 B WG IP） ============
SHOPIFY_WORKER_BASE_URL=http://10.88.0.20:8000
SHOPIFY_WORKER_TIMEOUT_SECONDS=120

# ============ R2（Cloudflare 对象存储） ============
R2_ENDPOINT=https://__ACCOUNT_ID__.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=__FILL__
R2_SECRET_ACCESS_KEY=__FILL__
R2_BUCKET=shopify-assets
R2_PUBLIC_BASE=https://cdn.biounetwork.com

# ============ Shopify Partner App ============
SHOPIFY_API_VERSION=2024-10
SHOPIFY_APP_KEY=__FILL__
SHOPIFY_APP_SECRET=__FILL__
SHOPIFY_WEBHOOK_SECRET=__FILL__
SHOPIFY_OAUTH_REDIRECT_URI=https://api.biounetwork.com/api/oauth/callback
SHOPIFY_OAUTH_CALLBACK_BASE=https://api.biounetwork.com/api
SHOPIFY_SAGA_FRONTEND_BASE=https://admin.biounetwork.com/newstore
SHOPIFY_DEV_MOCK_OAUTH=false

# ============ JWT（生产必须配，不能空） ============
# 生成：openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
__FILL_RSA_PRIVATE__
-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
__FILL_RSA_PUBLIC__
-----END PUBLIC KEY-----"

# ============ AES 加密主密钥（store token / dingtalk secret） ============
# 生成：openssl rand -base64 32
ENCRYPT_KEY_AES_GCM=__FILL_BASE64_32B__
BACKUP_ENCRYPT_KEY=__FILL_BACKUP_BASE64_32B__

# ============ 钉钉企业内部应用（fallback；多组织化优先用 sys_org_dingtalk_config 表） ============
DINGTALK_MAIN_CORP_ID=
DINGTALK_MAIN_AGENT_ID=
DINGTALK_MAIN_APP_KEY=
DINGTALK_MAIN_APP_SECRET=
DINGTALK_EVENT_TOKEN=
DINGTALK_EVENT_AES_KEY=

# ============ 邮件 SMTP（生产开通；dev 默认关） ============
SMTP_HOST=mail.biounetwork.com
SMTP_PORT=465
SMTP_USERNAME=noreply@biounetwork.com
SMTP_PASSWORD=__FILL__
SMTP_TLS=true
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_DINGTALK_ENABLED=true

# ============ 上传限制（默认 100MB / 200MB；超大视频生产可放大） ============
UPLOAD_MAX_FILE_SIZE=100MB
UPLOAD_MAX_REQUEST_SIZE=200MB

# ============ 邀请链接 / 跨公司授权 ============
INVITATION_LINK_BASE=https://admin.biounetwork.com/invitation/accept
INVITATION_TOKEN_SECRET=__FILL_RANDOM__

# ============ 前端公开 env（Next.js NEXT_PUBLIC_*） ============
NEXT_PUBLIC_API_BASE=https://api.biounetwork.com/api
NEXT_PUBLIC_BRAND_NAME="Biou × Shopify Control Center"

# ============ Swagger 在生产关 ============
SWAGGER_ENABLED=false
