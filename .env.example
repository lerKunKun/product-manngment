# ============================================
# Shopify Hub - .env.example
# 拷贝为 .env 后按需填值
# ============================================

# ===== 应用 =====
APP_ENV=dev
APP_PORT=8080
APP_BRAND_NAME="Biou x Shopify Control Center"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ENCRYPT_KEY_AES_GCM=                    # 32 字节 base64
BACKUP_ENCRYPT_KEY=                     # 32 字节 base64

# ===== 域名 =====
ROOT_DOMAIN=biounetwork.com
ADMIN_HOST=admin.biounetwork.com
API_HOST=api.biounetwork.com
OAUTH_HOST=oauth.biounetwork.com
WEBHOOK_HOST=webhook.biounetwork.com
DINGTALK_HOST=dingtalk.biounetwork.com

# ===== MySQL（本地 docker 用 3307 避开 brew mysql@8.0；生产 RDS 用 3306） =====
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_PLATFORM_DB=platform
MYSQL_TENANT_PREFIX=tenant_
MYSQL_TLS_REQUIRED=false                # 本地 false；生产强制 true

# ===== Redis（本地 docker 用 6380 避开 brew redis；生产 ElastiCache 用 6379） =====
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_TLS=false                         # 本地 false；生产强制 true

# ===== RabbitMQ（本地 docker / 生产节点 A 自建） =====
MQ_HOST=localhost
MQ_PORT=5672
MQ_USER=guest
MQ_PASS=guest

# ===== Cloudflare R2 / 本地 MinIO =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin             # 本地用 MinIO 默认凭证
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=shopify-assets-dev
R2_ENDPOINT=http://localhost:9000       # 本地 MinIO；生产 https://<account>.r2.cloudflarestorage.com
R2_PUBLIC_BASE=http://localhost:9000/shopify-assets-dev

# ===== 钉钉企业内部应用 =====
DINGTALK_MAIN_CORP_ID=
DINGTALK_MAIN_AGENT_ID=
DINGTALK_MAIN_APP_KEY=
DINGTALK_MAIN_APP_SECRET=
DINGTALK_EVENT_TOKEN=
DINGTALK_EVENT_AES_KEY=

# ===== Shopify =====
SHOPIFY_API_VERSION=2024-10
SHOPIFY_APP_KEY=
SHOPIFY_APP_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_OAUTH_REDIRECT_URI=https://oauth.biounetwork.com/oauth/callback

# ===== Worker =====
ASSET_WORKER_BASE_URL=http://localhost:9000
ASSET_WORKER_TOKEN=dev-worker-token
BACKEND_PROGRESS_URL=http://localhost:8080
INTERNAL_API_TOKEN=dev-internal-token

# ===== SMTP（backend 直连 SG 域名邮箱） =====
SMTP_HOST=mail.biounetwork.com
SMTP_PORT=465
SMTP_USERNAME=noreply@biounetwork.com
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=Biou x Shopify Control Center <noreply@biounetwork.com>

# ===== 临时员工邀请 =====
INVITATION_LINK_BASE=http://localhost:3000/invitation/accept
INVITATION_LINK_TTL_HOURS=48
TEMP_USER_MAX_DAYS=90
TEMP_USER_EXPIRY_CHECK_CRON=0 * * * *
TEMP_USER_REMINDER_CRON=0 9 * * *

# ===== 监控 =====
PROMETHEUS_ENDPOINT=
LOKI_ENDPOINT=
ALERTMANAGER_DINGTALK_WEBHOOK=
ALERTMANAGER_EMAIL_TO=ops@biounetwork.com

# ===== Cloudflare =====
CF_API_TOKEN=
CF_ZONE_ID=
CF_ACCESS_AUD=

# ===== 外部探活 =====
UPTIMEROBOT_API_KEY=

# ===== GitHub Actions 部署（仅 self-hosted runner 节点 C 持有） =====
GHCR_USER=
GHCR_TOKEN=
NODE_A_HOST=
NODE_C_HOST=
JUMP_HOST=
JUMP_SSH_USER=jump
JUMP_SSH_PORT=
DEPLOY_SSH_PRIVATE_KEY=
