# 节点 B asset-worker 环境变量模板
# 复制：sudo install -m 600 -o app -g app /dev/null /opt/asset-worker/.env

APP_ENV=prod
APP_PORT=8000

# Worker 内部 token（与节点 A 的 INTERNAL_API_TOKEN 一致）
ASSET_WORKER_TOKEN=__FILL_RANDOM_64B__
INTERNAL_API_TOKEN=__FILL_SAME_AS_NODE_A__

# R2
R2_ENDPOINT=https://__ACCOUNT_ID__.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=__FILL__
R2_SECRET_ACCESS_KEY=__FILL__
R2_BUCKET=shopify-assets
R2_PUBLIC_BASE=https://cdn.biounetwork.com
R2_REGION=auto

# RabbitMQ（节点 A 的 WG IP）
MQ_HOST=10.88.0.10
MQ_PORT=5672
MQ_USER=shopifyhub
MQ_PASS=__FILL_RMQ_PWD__

# Backend 进度回调（worker → backend，走 WG 内网）
BACKEND_PROGRESS_URL=http://10.88.0.10:8080/api/internal/asset

# Shopify
SHOPIFY_API_VERSION=2024-10

WORKER_DRY_RUN=false
